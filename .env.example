# =============================================================================
# Environment Variables untuk Vercel
# Salin file ini sebagai .env.local untuk development lokal.
# Di Vercel: tambahkan via dashboard → Project Settings → Environment Variables
# =============================================================================

# Token rahasia yang digunakan untuk menandatangani upload token (HMAC-SHA256).
# Nilai ini harus SAMA dengan UPLOAD_SECRET di Cloudflare Worker.
# Gunakan string acak yang panjang, misal: openssl rand -hex 32
UPLOAD_SECRET=ganti_dengan_secret_yang_kuat
